# --- Required ---

# MongoDB connection string (either name works; MONGODB_URI takes priority)
MONGODB_URI=mongodb://localhost:27017/champs
# MONGO_URI=

# Secret used to sign session JWTs — use a long random string
JWT_SECRET=replace-with-a-long-random-string

# Gmail account used to send OTP / admin emails via Nodemailer
# Use a Google App Password, not your normal account password
EMAIL_USER=your-gmail-address@gmail.com
EMAIL_PASS=your-gmail-app-password

# --- Optional ---

# Port for the Express API server (defaults to 5000)
BACKEND_PORT=5000

# Origin the Express server accepts requests from (defaults to localhost:3000)
FRONTEND_URL=http://localhost:3000

# Public site URL used in emails/referral links and Next.js metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# PUBLIC_SITE_URL=

# Secret path segment for the admin panel — visiting /admin/<value> unlocks it
# Leave unset to disable the admin panel
ADMIN_SECRET_KEY=

# Google Search Console ownership verification (HTML tag content value only)
# GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Google Analytics 4 measurement ID (only loaded in production builds)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Port the Next.js dev server proxies API requests to (matches BACKEND_PORT)
# NEXT_PUBLIC_BACKEND_PORT=5000

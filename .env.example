# --- Required ---

# MongoDB connection string (either name works; MONGODB_URI takes priority)
MONGODB_URI=mongodb://localhost:27017/champs
# MONGO_URI=

# Secret used to sign session JWTs — use a long random string
JWT_SECRET=replace-with-a-long-random-string

# Gmail account used to send OTP / admin emails via Nodemailer
# Use a Google App Password, not your normal account password
EMAIL_USER=your-gmail-address@gmail.com
EMAIL_PASS=your-gmail-app-password

# --- Optional ---

# Port for the Express API server (defaults to 5000)
BACKEND_PORT=5000

# Origin the Express server accepts requests from (defaults to localhost:3000)
FRONTEND_URL=http://localhost:3000

# Public site URL used in emails/referral links and Next.js metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# PUBLIC_SITE_URL=

# Secret path segment for the admin panel — visiting /admin/<value> unlocks it
# Leave unset to disable the admin panel
ADMIN_SECRET_KEY=

# Password required for admin write actions (delete user, send mail, create/delete links)
# Read-only admin views do not need this
ADMIN_PASS=

# Google verification is hardcoded in src/components/seo/google-verification.tsx
# - AdSense meta: google-adsense-account (ca-pub-4918938808225819)
# - Search Console: set GOOGLE_SITE_VERIFICATION in that file when you have the token

# Google Analytics 4 measurement ID (only loaded in production builds)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Mentor profile images: Supabase keys are hardcoded in
# server/lib/supabase-secrets.ts (SERVER ONLY — never import from src/)

# Instant Connect AI re-rank (optional). When set + parent adds notes,
# OpenAI re-orders the rule-scored shortlist. Leave unset for rules-only.
# OPENAI_API_KEY=
# OPENAI_IC_MODEL=gpt-4o-mini
# Snap & Grade — low-cost defaults (local OCR + mini). Override if needed.
# OPENAI_SNAP_GRADE_MODEL=gpt-4o-mini
# OPENAI_SNAP_GRADE_OCR_MODEL=gpt-4o-mini
# Legacy: OPENAI_SNAP_GRADE_MODEL=gpt-4o

# Snap & Grade Razorpay (production live keys). Webhook URL:
# POST https://your-api/api/snap-grade/webhook/razorpay
# RAZORPAY_LIVE_KEY_ID=
# RAZORPAY_LIVE_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# Paise per credit (default 100 = ₹1). Min recharge is 1 credit (₹1).
# SNAP_GRADE_CREDIT_PAISE=100
# Webhook is optional — credits are applied via /recharge/verify + Payments API.
# Port the Next.js dev server proxies API requests to (matches BACKEND_PORT)
# NEXT_PUBLIC_BACKEND_PORT=5000

# Optional GitHub token for /open-source live stats (stars, merged PRs, contributors).
# Public repo works without it (60 req/hr). With a token: 5,000 req/hr.
# Create at https://github.com/settings/tokens — no scopes needed for public repos
# (or fine-grained: read-only Metadata on adarshashokbaghel-code/mentr).
# GITHUB_TOKEN=

{
  "name": "mentr-python-l2-video",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts MentrPythonL2 output/mentr-python-level-2-launch.mp4 --codec=h264",
    "render:preview": "remotion render src/index.ts MentrPythonL2 output/mentr-python-level-2-preview.mp4 --codec=h264 --crf=23",
    "render:15": "remotion render src/index.ts DeviceLaunch15 output/mentr-python-intermediate-15s.mp4 --codec=h264 --crf=15 --jpeg-quality=95",
    "record:device": "npx tsx scripts/record-device-demo.ts",
    "frames": "remotion frames src/index.ts MentrPythonL2 output/frames --image-format=png --every-nth-frame=30"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.286",
    "@remotion/google-fonts": "^4.0.540",
    "@remotion/media-utils": "^4.0.286",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.286"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "typescript": "^5.6.3"
  }
}
